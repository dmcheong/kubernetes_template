            "skip_crds": false,
            "status": "deployed",
            "take_ownership": false,
            "timeout": 300,
            "timeouts": null,
            "upgrade_install": false,
            "values": [
              "global:\n  domain: argocd.local\n\nserver:\n  service:\n    type: NodePort\n\n  ingress:\n    enabled: false\n\nconfigs:\n  params:\n    server.insecure: true"
            ],
            "verify": false,
