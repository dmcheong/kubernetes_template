              "notes": "To connect to Kong, please execute the following commands:\nHOST=$(kubectl get nodes --namespace kong -o jsonpath='{.items[0].status.addresses[0].address}')\nPORT=$(kubectl get svc --namespace kong kong-kong-proxy -o jsonpath='{.spec.ports[0].nodePort}')\nexport PROXY_IP=${HOST}:${PORT}\ncurl $PROXY_IP\n\nOnce installed, please follow along the getting started guide to start using\nKong: https://docs.konghq.com/kubernetes-ingress-controller/latest/guides/getting-started/\n\n",
              "revision": 1,
              "values": "{\"admin\":{\"enabled\":true},\"deployment\":{\"kong\":{\"enabled\":true}},\"env\":{\"database\":\"off\",\"pg_database\":\"kong\",\"pg_host\":\"postgresql-postgresql.database.svc.cluster.local\",\"pg_password\":\"\",\"pg_user\":\"kong\"},\"ingressController\":{\"enabled\":true},\"proxy\":{\"enabled\":true,\"type\":\"NodePort\"},\"resources\":{\"limits\":{\"cpu\":\"500m\",\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"200m\",\"memory\":\"256Mi\"}}}",
